<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Tuner (AudioRecord). Requested at runtime by RepitchAudioModule.tunerStart. -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <!-- Background playback: Media3 MediaSessionService runs as a mediaPlayback foreground service. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <!-- ExoPlayer setWakeMode(WAKE_MODE_LOCAL): keeps the CPU awake while a local file plays. -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- POST_NOTIFICATIONS deliberately omitted: media-style notifications backed by a MediaSession are
       exempt from the Android 13+ notification permission, and lock-screen controls do not need it. -->

  <application>
    <service
      android:name="expo.modules.repitchaudio.PlaybackService"
      android:exported="true"
      android:foregroundServiceType="mediaPlayback">
      <intent-filter>
        <action android:name="androidx.media3.session.MediaSessionService" />
      </intent-filter>
    </service>
  </application>
</manifest>
