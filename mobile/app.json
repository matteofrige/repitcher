{
  "expo": {
    "name": "RePitch",
    "slug": "repitch",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "repitch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "it.re-pitch.repitch",
      "buildNumber": "9",
      "appleTeamId": "BY6ANXN7HT",
      "infoPlist": {
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription":"RePitch uses the microphone only for the tuner, to recognise the note you play.",
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "it"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F1E6C8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "package": "it.repitch.RePitch",
      "versionCode": 11,
      "permissions": [
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withNoUserScriptSandboxing",
      "./plugins/withSceneLifecycle",
      "./plugins/withAutomaticSigning",
      "./plugins/withAndroidReleaseSigning",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1E6C8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#1B1510",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": false,
          "supportedLocales": {
            "android": [
              "it",
              "en"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "it": "./locales/it.json",
      "en": "./locales/en.json"
    }
  }
}
